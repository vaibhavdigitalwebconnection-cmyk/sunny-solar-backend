# Sunny Solar Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) - Comma-separated allowed origins for CORS
# In production, set to your live website domain(s) e.g.:
CLIENT_URL=https://sunnysolar.com.au,https://www.sunnysolar.com.au,https://sunny-solar.vercel.app,http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/sunny-solar?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=generate_a_long_random_secure_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used during database seeding)
ADMIN_EMAIL=admin@sunnysolar.com.au
ADMIN_PASSWORD=ChangeMeInProduction123!

# Cloudinary (Image Uploads & Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
